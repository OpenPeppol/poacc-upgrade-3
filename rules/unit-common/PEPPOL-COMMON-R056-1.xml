<?xml version="1.0" encoding="UTF-8"?>
<testSet xmlns="http://difi.no/xsd/vefa/validator/1.0" configuration="peppolbis-t01-base-3.0">
	<assert>
		<description>Dutch VAT numbers with scheme 9944 must use the NL999999999B99 format.</description>
		<scope>PEPPOL-COMMON-R056-1</scope>
	</assert>
	<test>
		<assert><success>PEPPOL-COMMON-R056-1</success></assert>
		<Order xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns="urn:oasis:names:specification:ubl:schema:xsd:Order-2">
			<cac:BuyerCustomerParty><cac:Party><cac:PartyIdentification><cbc:ID schemeID="9944">NL123456789B12</cbc:ID></cac:PartyIdentification></cac:Party></cac:BuyerCustomerParty>
		</Order>
	</test>
	<test>
		<assert><warning number="1">PEPPOL-COMMON-R056-1</warning></assert>
		<Order xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns="urn:oasis:names:specification:ubl:schema:xsd:Order-2">
			<cac:BuyerCustomerParty><cac:Party><cac:PartyIdentification><cbc:ID schemeID="9944">NL12345678B12</cbc:ID></cac:PartyIdentification></cac:Party></cac:BuyerCustomerParty>
		</Order>
	</test>
</testSet>
