<?xml version="1.0" encoding="UTF-8"?>
<testSet xmlns="http://difi.no/xsd/vefa/validator/1.0" configuration="peppolbis-t01-base-3.0">
	<assert>
		<description>A quotation document reference is required when an order references a quotation line.</description>
		<scope>PEPPOL-T01-R035</scope>
	</assert>
	<test>
		<assert><success>PEPPOL-T01-R035</success></assert>
		<Order xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns="urn:oasis:names:specification:ubl:schema:xsd:Order-2">
			<cac:QuotationDocumentReference><cbc:ID>Q-1</cbc:ID></cac:QuotationDocumentReference>
			<cac:OrderLine><cac:LineItem><cac:QuotationLineReference><cbc:LineID>1</cbc:LineID></cac:QuotationLineReference></cac:LineItem></cac:OrderLine>
		</Order>
	</test>
	<test>
		<assert><error>PEPPOL-T01-R035</error></assert>
		<Order xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns="urn:oasis:names:specification:ubl:schema:xsd:Order-2">
			<cac:OrderLine><cac:LineItem><cac:QuotationLineReference><cbc:LineID>1</cbc:LineID></cac:QuotationLineReference></cac:LineItem></cac:OrderLine>
		</Order>
	</test>
</testSet>
